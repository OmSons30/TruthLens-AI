{
  "manifest_version": 3,
  "name": "TruthLens AI — Verify with TruthLens",
  "version": "1.0.0",
  "description": "Instant misinformation detection and AI content verification. Analyze text, images, and screenshots from any webpage.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "TruthLens AI — Verify Content"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.facebook.com/*",
        "https://www.instagram.com/*",
        "https://www.youtube.com/*",
        "https://*.reuters.com/*",
        "https://*.bbc.com/*",
        "https://*.cnn.com/*",
        "https://*.aljazeera.com/*",
        "https://*.ndtv.com/*",
        "https://*.thehindu.com/*",
        "https://*.nytimes.com/*",
        "https://*.theguardian.com/*",
        "https://*.washingtonpost.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
